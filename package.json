{
  "name": "claudes-babysitter",
  "version": "4.7.1",
  "private": true,
  "description": "Claude's Babysitter \u2014 keeps AI code generators inside a product's UI system: AST lint rules, static WCAG contrast of theme tokens, component-reuse audit, Claude Code + git hooks and Playwright micro-checks. Enforces the UI Architecture & Consistency Guidelines (58 recurring UI bug patterns).",
  "type": "module",
  "bin": {
    "babysitter": "bin/babysitter.mjs",
    "claudes-babysitter": "bin/babysitter.mjs"
  },
  "exports": {
    "./eslint": "./rules/eslint/index.js",
    "./stylelint": "./rules/stylelint/config.js",
    "./lib/*": "./lib/*",
    "./playwright/*": "./playwright/*"
  },
  "files": [
    "README.md",
    "bin",
    "docs",
    "lib",
    "playwright",
    "rules",
    "studio",
    "templates"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run test:eslint && npm run test:stylelint && npm run test:check && npm run test:tt && npm run test:team && npm run test:acceptance && npm run test:studio",
    "test:eslint": "node rules/eslint/test.mjs",
    "test:stylelint": "node rules/stylelint/test.mjs",
    "check": "node bin/ui-check.mjs",
    "check:changed": "node bin/ui-check.mjs --changed --format agent",
    "audit": "node bin/ui-audit.mjs",
    "ui:prepare": "node playwright/prepare.mjs",
    "test:ui": "playwright test -c playwright/playwright.config.ts",
    "test:check": "node test/ui-check.test.mjs && node test/audit-safety.test.mjs && node test/route-map.test.mjs && node test/checks-runtime.test.mjs",
    "test:tt": "node test/time-travel.test.mjs && node test/tool-failure.test.mjs && node test/proposals.test.mjs",
    "init": "node bin/ui-init.mjs",
    "test:studio": "npm test -w @babysitter/studio",
    "test:team": "node test/team.test.mjs",
    "test:acceptance": "node test/acceptance.test.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/typescript-estree": "^8.71.0",
    "eslint": "^9.12.0",
    "http-proxy": "^1.18.1",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.9.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souldevsoul/claudes-babysitter.git"
  },
  "homepage": "https://github.com/souldevsoul/claudes-babysitter#readme",
  "keywords": [
    "ui",
    "design-system",
    "eslint",
    "stylelint",
    "playwright",
    "wcag",
    "contrast",
    "claude-code",
    "hooks",
    "ai-codegen",
    "tailwind",
    "shadcn"
  ],
  "workspaces": [
    "studio"
  ]
}
