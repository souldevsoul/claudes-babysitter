{
  "$comment": "Claude's Babysitter project settings. Every allowance is a design decision — write the reason next to it.",
  "name": "my-product",
  "baseURL": "https://your-preview.vercel.app",
  "devServer": "http://localhost:3000",
  "routes": ["/", "/pricing"],
  "authRoutes": ["/dashboard"],
  "sampleParams": { "id": "demo" },
  "login": { "url": "/login" },
  "crawl": { "maxPages": 25, "exclude": ["/blog/"] },
  "colorSchemes": ["light", "dark"],
  "kit": ["StatTile", "PlanCard", "SectionHeader"],
  "themePaths": ["**/components/ui/**", "**/theme/**"],
  "themeFirst": true,
  "contrast": true,
  "contrastTokens": {},
  "registry": "",
  "similarityThreshold": 0.8,
  "allow": {
    "rails": false,
    "emoji": false,
    "negativeMargins": false,
    "lightWeights": false,
    "palette": false,
    "cssInJsLiterals": false
  },
  "allowReasons": {
    "lightWeights": "editorial brand: 200-weight display serif — contrast is still enforced"
  },
  "consistency": { "buttonRadii": 2, "buttonFonts": 1, "buttonHeights": 3, "cardRadii": 3, "cardStyles": 4, "inputHeights": 2, "inputRadii": 2 },
  "motion": { "maxClicks": 30 },
  "viewports": [360, 390, 768, 1280, 1440],
  "roles": [
    { "name": "specialist", "env": { "LOGIN_EMAIL": "SPECIALIST_EMAIL", "LOGIN_PASSWORD": "SPECIALIST_PASSWORD" } }
  ],
  "locales": { "list": ["en", "az"], "default": "en", "cookie": "NEXT_LOCALE", "keep": ["Acme Pro"], "untranslated": "fail" },
  "states": { "enabled": true, "maxOpeners": 15, "maxForms": 3, "maxSteps": 6, "wallet": true, "pageBudget": 240000 },
  "acceptance": { "auth": { "signIn": "/login", "signUp": "/register", "settings": "/settings" }, "skip": [], "skipReasons": {} },
  "content": { "dateFormat": "DD.MM.YYYY", "dashes": "forbid", "brandTerms": ["Acme"], "legalIdentity": ["New Company 1", "New Address 1", "000000000"], "glossary": {}, "skip": [], "skipReasons": {} },
  "forms": { "zeroBalanceRole": "", "protectedRoute": "/dashboard", "skip": [], "skipReasons": {} },
  "layout": { "headingVariants": 2, "stickyHeader": true, "maxListItems": 20, "registerFavicon": true, "rateDecimals": 4 },
  "domSniper": { "allowProps": [], "skip": [], "strict": false },
  "ignore": ["src/legacy/"],
  "audit": { "exclude": ["design-lab"] }
}
